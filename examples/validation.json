{
  "scenario_version": "1",
  "name": "todo-client-validation",
  "description": "UI rejection of blank and whitespace fixtures, with no POST in each settled action window and no invalid record in a post-reload fresh collection. Direct API validation remains separate API coverage.",
  "start_url": "http://127.0.0.1:8767/",
  "steps": [
    {
      "id": "reject-blank",
      "goal": "Submit an empty Todo title once. The expected outcome is the visible message 'Title must not be blank or whitespace only.' Stop as soon as that message appears; do not correct the input or submit again.",
      "fixtures": {
        "title": ""
      },
      "scope": {
        "css": "#create-form"
      },
      "reload_after": true,
      "assertions": [
        {
          "kind": "attribute",
          "selector": {
            "css": "#create-input"
          },
          "name": "aria-invalid",
          "expected": "true"
        },
        {
          "kind": "attribute",
          "selector": {
            "css": "#create-status"
          },
          "name": "data-state",
          "expected": "error"
        },
        {
          "kind": "equals",
          "selector": {
            "css": "#create-status"
          },
          "expected": "Title must not be blank or whitespace only."
        },
        {
          "kind": "no_request",
          "method": "POST",
          "path": "/api/todos"
        },
        {
          "kind": "persistence",
          "method": "GET",
          "path": "/api/todos",
          "records_path": "$.todos",
          "contains": {
            "title": ""
          },
          "absent": true
        }
      ]
    },
    {
      "id": "reject-whitespace",
      "goal": "Set Todo title to exactly the supplied three spaces and submit once. The expected outcome is the visible message 'Title must not be blank or whitespace only.' Stop as soon as that message appears; do not trim or correct the input.",
      "fixtures": {
        "title": "   "
      },
      "scope": {
        "css": "#create-form"
      },
      "reload_after": true,
      "assertions": [
        {
          "kind": "attribute",
          "selector": {
            "css": "#create-input"
          },
          "name": "aria-invalid",
          "expected": "true"
        },
        {
          "kind": "attribute",
          "selector": {
            "css": "#create-status"
          },
          "name": "data-state",
          "expected": "error"
        },
        {
          "kind": "equals",
          "selector": {
            "css": "#create-status"
          },
          "expected": "Title must not be blank or whitespace only."
        },
        {
          "kind": "no_request",
          "method": "POST",
          "path": "/api/todos"
        },
        {
          "kind": "persistence",
          "method": "GET",
          "path": "/api/todos",
          "records_path": "$.todos",
          "contains": {
            "title": "   "
          },
          "absent": true
        },
        {
          "kind": "persistence",
          "method": "GET",
          "path": "/api/todos",
          "records_path": "$.todos",
          "contains": {
            "title": ""
          },
          "absent": true
        }
      ]
    }
  ]
}
