# jev-qa runner configuration. Copy to .env (gitignored) and fill in values.
# The CLI loads this file silently; values reach the runner as ordinary
# environment variables. None of these are echoed in the report.

# Required for live Jev calls. The runner exits BLOCKED when this is missing.
TYPESAFE_API_KEY=

# Model id override. Defaults to jev-1.13.0.
# TYPESAFE_MODEL=jev-1.13.0

# Optional Chrome executable path. When unset, jev-qa auto-detects common
# Chrome/Chromium installs on macOS and Linux.
# JEV_QA_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: run Chrome headless. Default headed for demos.
# JEV_QA_HEADLESS=0
